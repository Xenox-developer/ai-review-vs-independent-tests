      "text_diff": "--- before/public.json\n+++ after/public.json\n@@ -0,0 +1,18 @@\n+[\n+  {\n+    \"expect\": [\n+      null\n+    ],\n+    \"input\": {\n+      \"capacity\": 1,\n+      \"events\": [\n+        {\n+          \"key\": \"x\",\n+          \"op\": \"get\",\n+          \"t\": 0\n+        }\n+      ],\n+      \"ttl\": 10\n+    }\n+  }\n+]\n",
