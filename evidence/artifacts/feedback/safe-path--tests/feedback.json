    {
      "input": {
        "path": ".hidden/a..b/..hidden/..."
      },
      "expect": ".hidden/a..b/..hidden/..."
    },
    {
      "input": {
        "path": "%2E/a/%2e/b%2Fc/"
      },
      "expect": "a/b/c"
    },
    {
      "input": {
        "path": "a+b/%2B/%20"
      },
      "expect": "a+b/+/ "
    },
    {
