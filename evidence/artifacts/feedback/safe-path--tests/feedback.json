      },
      "expect": "a/b"
    },
    {
      "input": {
        "path": "a/%2E%2E%2E/b"
      },
      "expect": "a/.../b"
    },
    {
      "input": {
        "path": "%EF%BB%BFfile"
      },
      "expect": "\ufefffile"
    },
    {
