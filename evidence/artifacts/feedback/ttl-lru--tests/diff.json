      "text_diff": "--- before/solution.py\n+++ after/solution.py\n@@ -0,0 +1,11 @@\n+def solve(data):\n+    cache = {}\n+    out = []\n+    for e in data['events']:\n+        if e['op'] == 'put':\n+            cache[e['key']] = (e['value'], e['t'] + data['ttl'])\n+            if len(cache) > data['capacity']: cache.pop(next(iter(cache)))\n+        else:\n+            v = cache.get(e['key'])\n+            out.append(v[0] if v and v[1] >= e['t'] else None)\n+    return out\n",
      "text_diff_truncated": false
